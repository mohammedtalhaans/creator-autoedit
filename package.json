{
  "name": "creator-autoedit",
  "version": "0.9.0-rc.2",
  "private": true,
  "type": "module",
  "description": "A private, on-device talking-video editor. Signal Studio edition.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run prepare:assets && tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:core:offline": "node scripts/test-core-offline.cjs",
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "verify:release": "node scripts/release-check.mjs",
    "predev": "npm run prepare:assets",
    "format": "prettier --write src tests e2e scripts *.json *.ts *.js *.md .github",
    "test:production": "playwright test --config playwright.production.config.ts",
    "test:source:offline": "node scripts/verify-source-offline.cjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.2.6",
    "@fontsource-variable/jetbrains-mono": "^5.2.6",
    "@fontsource/barlow-condensed": "^5.2.6",
    "@mediabunny/aac-encoder": "^1.54.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "4.4.6",
    "lucide-react": "^0.468.0",
    "mammoth": "1.12.3",
    "mediabunny": "^1.54.0",
    "motion": "^12.23.24",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/vite": "^4.1.17",
    "@types/dom-webcodecs": "^0.1.16",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "fake-indexeddb": "6.2.5",
    "globals": "^16.5.0",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^8.2.2",
    "vitest": "^4.0.8"
  }
}
